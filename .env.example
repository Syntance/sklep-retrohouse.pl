# Medusa (storefront → backend Railway)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://medusa-backend-production-9270.up.railway.app
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Public URL (canonical metadata OG / metadataBase)
NEXT_PUBLIC_SITE_URL=https://sklep-retrohouse.pl

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Trwała domena CDN mediów Medusa (Cloudflare R2 / S3) — patrz docs/runbook/railway-disaster-recovery.md.
# Po migracji storage backendu z dysku Railway na R2, np. https://assets.sklep-retrohouse.pl
NEXT_PUBLIC_MEDIA_CDN_URL=

# Upload CMS hero — bezpośrednio do R2 (omija Medusa /admin/uploads). Skopiuj z Railway → Medusa Backend.
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_BUCKET=lumine-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://assets.sklep-retrohouse.pl
# S3_FILE_URL=https://pub-XXXX.r2.dev
# S3_REGION=auto
# NEXT_PUBLIC_S3_FILE_URL=https://pub-XXXX.r2.dev
# NEXT_PUBLIC_CMS_MEDIA_BASE_URL=https://pub-XXXX.r2.dev

# Sanity (CDN obrazy — hero produktu, Studio pod /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# PostHog (EU host wymagany — RODO art. 44+, hosting w EU bez transferu poza)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Panel magazynu — odczyt analityki (server-only, osobne od klucza publicznego)
# POSTHOG_PERSONAL_API_KEY=   # PostHog → Settings → Personal API keys
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=https://eu.posthog.com
# GA4_PROPERTY_ID=            # opcjonalnie — storefront nie ma dziś gtag/GA4 (ADR-0010)
# GA4_SERVICE_ACCOUNT_JSON=   # JSON service account w jednej linii
# FEATURE_ANALYTICS_PANEL=1   # ustaw 0 aby wyłączyć fetch w panelu

# Meta Pixel — opcjonalny; bez ID kategoria marketingowa jest no-op (graceful degradation)
NEXT_PUBLIC_META_PIXEL_ID=

# Live commerce na homepage (Sanity etap 2 — ADR-0006).
# DATE w ISO 8601 z timezone, np. 2026-05-22T18:00:00+02:00
NEXT_PUBLIC_LIVE_SCHEDULED=false
NEXT_PUBLIC_LIVE_DATE=
NEXT_PUBLIC_LIVE_DROP_TITLE=
NEXT_PUBLIC_LIVE_DROP_COUNT=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Resend — formularz /kontakt (server-only). Klucz tylko w .env.local / Vercel, nie w repo.
RESEND_API_KEY=
# Na produkcji: kontakt@sklep-retrohouse.pl (wymaga zweryfikowanej domeny w Resend). W sandboxie: onboarding@resend.dev
RESEND_FROM_EMAIL=kontakt@sklep-retrohouse.pl
RESEND_CONTACT_TO=kontakt@sklep-retrohouse.pl

# Opcjonalne — odczyt zamówień do maili transakcyjnych i epok w SSR (te same dane co /magazyn)
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

# --- Cloudflare API (tylko skrypt scripts/cloudflare-sync-vercel-dns.sh; nie Next.js) ---
# Skopiuj do .env.cf.local (gitignored): CLOUDFLARE_API_TOKEN + CLOUDFLARE_ZONE_NAME
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_NAME=sklep-retrohouse.pl
# CLOUDFLARE_ZONE_ID=
