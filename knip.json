{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/app/**/{page,layout,template,error,loading,not-found,route,sitemap,robots,opengraph-image,manifest}.{ts,tsx}",
		"src/app/**/*.{ts,tsx}!"
	],
	"project": ["src/**/*.{ts,tsx}"],
	"ignore": ["src/components/ui/**"],
	"ignoreDependencies": [
		"@fontsource-variable/inter",
		"@fontsource/playfair-display",
		"shadcn",
		"tailwindcss",
		"tw-animate-css"
	],
	"ignoreBinaries": ["only-allow"]
}
